# Copy this file to .env and edit it, then run ./deploy.sh
#   cp .env.example .env

# One or more folders on THIS machine that contain your videos, separated
# by commas. Each one becomes its OWN library in the app (its own entry
# in the sidebar, its own name) — this is about separate host paths, not
# subfolders. Organizing videos into subfolders *within* one of these
# paths (e.g. MEDIA_PATHS=/mnt/media, with /mnt/media/Movies and
# /mnt/media/TV inside it) keeps them as one browsable library with
# folders, not two libraries — see README.md's "Multiple libraries"
# section if you want the subfolder-merging behavior explained.
#
#   One library:        MEDIA_PATHS=/mnt/media
#   Several libraries:   MEDIA_PATHS=/mnt/movies,/mnt/tv,/mnt/home-videos
#
# If any path contains a space, quote the whole value:
#   MEDIA_PATHS="/mnt/movies,/mnt/My Home Videos"
#
# deploy.sh will print exactly which folder maps to which library name
# and ask you to confirm before mounting anything.
MEDIA_PATHS=/path/to/your/videos

# Where the app stores ITS OWN data on this machine: the index database,
# generated thumbnails/preview sprites, and your server name/login/
# settings. Created automatically if it doesn't exist. This is the one
# directory worth backing up — losing it just means redoing first-run
# setup and rebuilding thumbnails, never losing any actual video.
DATA_DIR_HOST=./data

# Port to reach the app on, on this machine: http://<this-machine>:PORT
PORT=8080

# Only change these if they collide with something else already running.
CONTAINER_NAME=playhead
IMAGE_NAME=playhead:latest
